# Copy to backend/.env and fill in for local development.
#
# Quickest local Postgres: a single Docker container (see README/plan notes
# for the full docker run command) matching these default credentials —
# swap them for your own setup if you're not using Docker.
DATABASE_URL=postgresql://skinlesion:devpassword@localhost:5432/skin_lesion_db
STORAGE_DIR=./storage
MODEL_CHECKPOINT_PATH=../ml/models/efficientnet_b0_ham10000.pt
DEVICE=cpu
CORS_ORIGINS=http://localhost:3000
